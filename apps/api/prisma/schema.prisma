generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enumerações ───────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  GUARDIAN
  TUTOR
  ADMIN
}

enum TutorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassType {
  ONE_ON_ONE
  GROUP
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsentType {
  DATA_PROCESSING
}

enum ContentType {
  VIDEO
  DOCUMENT
}

enum DeliveryChannel {
  EMAIL
  PUSH
  SMS
}

enum NotifType {
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  BOOKING_ENROLLED
  BOOKING_ENROLLMENT_CANCELLED
  TUTOR_APPROVED
  TUTOR_REJECTED
  ROLE_CHANGE_APPROVED
  ROLE_CHANGE_REJECTED
  CONTENT_READY
}

// DRAFT → PUBLISHED → ARCHIVED; o tutor pode voltar a DRAFT de ARCHIVED.
// O modelo pode ser alargado (ex.: REVIEW, SCHEDULED) sem migração destrutiva.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

// ── Modelos ───────────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(uuid())
  name        String
  email       String  @unique
  password    String
  nifTaxId    String? @unique
  role        Role
  guardianId  String?
  birthDate   DateTime? @db.Date
  phoneNumber String?

  // MFA (TOTP). O segredo fica cifrado (AES-GCM) ao nível da aplicação, nunca em claro
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  mfaEnabledAt DateTime?

  guardian   User?  @relation("GuardianStudents", fields: [guardianId], references: [id])
  dependents User[] @relation("GuardianStudents")

  createdAt DateTime @default(now())

  tutorProfile     TutorProfile?
  enrollments      ClassEnrollment[]
  reviewsGiven     Review[]           @relation("ReviewAuthor")
  payments         PaymentTransaction[]
  hourPackages     HourPackage[]
  guardianConsents GuardianConsent[]  @relation("GuardianConsents")
  studentConsents  GuardianConsent[]  @relation("StudentConsents")
  auditLogs        AuditLog[]
  mfaRecoveryCodes MfaRecoveryCode[]
  roleChangesTarget    RoleChangeRequest[] @relation("RoleChangeTarget")
  roleChangesRequested RoleChangeRequest[] @relation("RoleChangeRequester")
  roleChangesDecided   RoleChangeRequest[] @relation("RoleChangeDecider")
  notificationPreferences NotificationPreference[]
  pushTokens           PushToken[]

  @@index([guardianId])
}

// Códigos de recuperação do MFA: uso único, guardados só como HMAC (não são recuperáveis)
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Alteração de papel com segregação de funções (RN-08): um admin pede, outro admin decide.
// A BD impede que quem pede seja quem decide (CHECK na migração).
model RoleChangeRequest {
  id            String       @id @default(uuid())
  targetId      String
  target        User         @relation("RoleChangeTarget", fields: [targetId], references: [id])
  fromRole      Role
  toRole        Role
  requestedById String
  requestedBy   User         @relation("RoleChangeRequester", fields: [requestedById], references: [id])
  status        ChangeStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?        @relation("RoleChangeDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@index([targetId])
}

model TutorProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id])
  status            TutorStatus @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  bio               String?
  subjects          String[]
  levels            String[]
  avatarKey         String?
  hourlyRate        Decimal?    @db.Decimal(12, 2)
  diplomaKey        String?
  criminalRecordKey String?
  passportPhotoKey  String?
  videoIntroKey     String?
  ratingAverage     Float       @default(0)
  totalReviews      Int         @default(0)
  totalClasses      Int         @default(0)
  totalStudents     Int         @default(0)

  sessions     ClassSession[]
  reviews      Review[]       @relation("ReviewTarget")
  contentItems ContentItem[]
}

model ClassSession {
  id          String    @id @default(uuid())
  tutorId     String
  tutor       TutorProfile @relation(fields: [tutorId], references: [id])
  title       String
  subject     String
  type        ClassType
  maxCapacity Int       @default(7)
  scheduledAt DateTime
  durationMin Int

  enrollments ClassEnrollment[]
  reviews     Review[]

  @@index([tutorId, scheduledAt])
  @@index([scheduledAt])
}

model ClassEnrollment {
  id               String       @id @default(uuid())
  classId          String
  session          ClassSession @relation(fields: [classId], references: [id])
  studentId        String
  student          User         @relation(fields: [studentId], references: [id])
  attendanceStatus AttendanceStatus @default(PENDING)
  // Horas debitadas e pacote de origem: permitem estornar ao cancelar
  hoursDebited     Decimal      @db.Decimal(6, 2)
  packageId        String?
  package          HourPackage? @relation(fields: [packageId], references: [id])
  createdAt        DateTime     @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([classId])
}

model Review {
  id              String       @id @default(uuid())
  studentId       String
  student         User         @relation("ReviewAuthor", fields: [studentId], references: [id])
  tutorId         String
  tutor           TutorProfile @relation("ReviewTarget", fields: [tutorId], references: [id])
  // Uma avaliação por aula a que o aluno assistiu (presença confirmada pelo tutor)
  classId         String
  session         ClassSession @relation(fields: [classId], references: [id])
  rating          Int
  comment         String?
  punctuality     Int
  subjectMastery  Int
  didacticClarity Int
  progress        Int
  createdAt       DateTime     @default(now())

  @@unique([studentId, classId])
  @@index([tutorId])
  @@index([classId])
}

// Catálogo de pacotes de horas. Preços, composição e validade ainda são decisão do cliente,
// por isso são geridos pelo Administrador em vez de fixos no código.
model PackageOffer {
  id           String   @id @default(uuid())
  name         String
  hours        Decimal  @db.Decimal(6, 2)
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("AOA")
  validityDays Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  transactions PaymentTransaction[]

  @@index([active])
}

model PaymentTransaction {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  gateway            String
  reference          String
  // Entidade de pagamento, nos gateways que a exigem (estilo Multicaixa)
  entity             String?
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("AOA")
  status             PaymentStatus @default(PENDING)
  idempotencyKey     String        @unique
  // Valores do pacote no momento da compra: alterar a oferta não afecta pagamentos pendentes
  offerId            String?
  offer              PackageOffer? @relation(fields: [offerId], references: [id])
  hours              Decimal       @db.Decimal(6, 2)
  validityDays       Int?
  referenceExpiresAt DateTime?
  confirmedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  hourPackage HourPackage?

  @@unique([gateway, reference])
  @@index([userId, status])
}

// Deduplicação de webhooks: o mesmo evento entregue duas vezes só tem efeito uma vez (RNF-SEG-04)
model PaymentWebhookEvent {
  id         String   @id @default(uuid())
  gateway    String
  eventId    String
  receivedAt DateTime @default(now())

  @@unique([gateway, eventId])
}

model HourPackage {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  paymentId      String             @unique
  payment        PaymentTransaction @relation(fields: [paymentId], references: [id])
  totalHours     Decimal
  remainingHours Decimal
  releasedAt     DateTime           @default(now())
  expiresAt      DateTime?

  enrollments ClassEnrollment[]
}

model GuardianConsent {
  id          String    @id @default(uuid())
  guardianId  String
  guardian    User      @relation("GuardianConsents", fields: [guardianId], references: [id])
  studentId   String
  student     User      @relation("StudentConsents", fields: [studentId], references: [id])
  consentType ConsentType
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([studentId])
  @@index([guardianId])
}

// Conteúdo pedagógico gerido pelo tutor (RF-CON-01/02/03).
// storageKey/dataliteKey nunca saem da API; o cliente recebe URLs assinadas de curta duração (DPM).
// dataliteKey é preenchido assincronamente pelo worker de transcodificação (BullMQ, a implementar).
model ContentItem {
  id             String        @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile  @relation(fields: [tutorProfileId], references: [id])
  title          String
  description    String?
  type           ContentType
  status         ContentStatus @default(DRAFT)
  isPaid         Boolean       @default(false)
  storageKey     String?
  dataliteKey    String?
  subject        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tutorProfileId, status])
  @@index([subject, status])
}

// ── Notificações ─────────────────────────────────────────────────────────────

// Preferência de um utilizador por canal e tipo de notificação.
// Ausência de registo = enabled por defeito (opt-out explícito).
model NotificationPreference {
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel DeliveryChannel
  type    NotifType
  enabled Boolean         @default(true)

  @@id([userId, channel, type])
}

// Interruptor global gerido pelo administrador.
// Preenchido na migração com todos os canais enabled=true.
model ChannelConfig {
  channel   DeliveryChannel @id
  enabled   Boolean         @default(true)
  updatedAt DateTime        @updatedAt
}

// Token de push por dispositivo (FCM para Android/iOS, Web Push para browsers).
// p256dh + auth só presentes nos tokens Web Push; tokens FCM têm apenas token + endpoint="fcm".
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  endpoint  String
  p256dh    String?
  auth      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Registo de auditoria imutável com encadeamento de hash (append-only).
// hashPrev → hash do registo anterior; hashSelf → SHA-256 deste registo.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  entityType String
  entityId   String
  action     String
  hashPrev   String
  hashSelf   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
