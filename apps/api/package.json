{
  "name": "educa-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "payments:simulate": "tsx scripts/simulate-webhook.ts",
    "mfa:reset": "tsx scripts/reset-mfa.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "contract:build": "pnpm openapi:generate && openapi-typescript openapi.json -o ../../packages/api-types/index.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.2",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4",
    "uuid": "^11.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "openapi-typescript": "^7.13.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
