# ── Base de dados ────────────────────────────────────────────────────────────
# URL via PgBouncer (usado pelo runtime da aplicação)
DATABASE_URL="postgresql://educa_user:educa_pass@localhost:6432/educa?pgbouncer=true&connection_limit=1"
# URL directa ao PostgreSQL (usado pelo Prisma para migrações)
DIRECT_URL="postgresql://educa_user:educa_pass@localhost:5432/educa"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
ACCESS_TOKEN_SECRET="CHANGE_ME_32_CHARS_MIN_ACCESS_SECRET"
REFRESH_TOKEN_SECRET="CHANGE_ME_32_CHARS_MIN_REFRESH_SECRET"
ACCESS_TOKEN_EXPIRY="15m"
# 7 dias em segundos
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ── MFA (TOTP) ───────────────────────────────────────────────────────────────
# Chave que cifra os segredos TOTP em repouso. Gerar com: openssl rand -hex 32
# Perdê-la invalida todos os MFA configurados; em produção guardá-la num serviço de segredos.
MFA_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS_RUN_openssl_rand_hex_32_AND_PASTE_HERE_0000"

# ── Pagamentos por referência ────────────────────────────────────────────────
# Gateway activo. 'sandbox' = simulador local (proibido em produção).
# Quando o gateway real for decidido: PAYMENT_GATEWAY=proxypay (ou paypay, kwanza…)
PAYMENT_GATEWAY="sandbox"
PAYMENT_REFERENCE_TTL_HOURS=72

# ── Sandbox (simulador local) ─────────────────────────────────────────────────
# Necessário quando PAYMENT_GATEWAY=sandbox. Gerar com: openssl rand -hex 32
SANDBOX_WEBHOOK_SECRET="CHANGE_ME_32_CHARS_MIN_WEBHOOK_SECRET"

# ── Proxypay (activar quando PAYMENT_GATEWAY=proxypay) ───────────────────────
# PROXYPAY_API_URL="https://api.proxypay.co.ao"
# PROXYPAY_API_KEY="CHANGE_ME"
# PROXYPAY_WEBHOOK_SECRET="CHANGE_ME_32_CHARS_MIN"

# ── PayPay / Kwanza Online (blocos análogos ao Proxypay quando decidido) ──────
# PAYPAY_API_URL=""
# PAYPAY_API_KEY=""
# PAYPAY_WEBHOOK_SECRET=""

# ── Object storage (S3-compatível; MinIO em desenvolvimento) ─────────────────
# Em produção, omitir S3_ENDPOINT e usar credenciais IAM de menor privilégio
S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_BUCKET="educa-private"
S3_ACCESS_KEY="educa_minio"
S3_SECRET_KEY="educa_minio_secret"
S3_FORCE_PATH_STYLE=true

# ── Aplicação ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Origens permitidas (separadas por vírgula): back-office SvelteKit em dev
CORS_ORIGIN="http://localhost:3001"
